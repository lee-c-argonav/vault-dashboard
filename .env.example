# Copy to .env and fill in. .env is gitignored and holds machine- and
# account-specific values, so nothing here leaks into the tracked source.
# server.js loads .env at boot; tools.json references these as ${VAR}.

# The Obsidian vault to read and watch (absolute path).
VAULT_HUD_VAULT=/absolute/path/to/your/obsidian/vault
# Port for the local server (default 5959 if unset).
VAULT_HUD_PORT=5959
# Where the usage poller keeps usage-tokens.json (OAuth bundles, mode 0600)
# and usage.json (the public-safe snapshot the HUD reads). Default:
# ~/Library/Application Support/vault-hud. Never point this into the repo or
# the vault — the token file must stay out of anything with a remote.
VAULT_HUD_DATA_DIR=/absolute/path/to/usage/data

# --- Action-bar shortcut targets (all optional; a shortcut whose only
# --- URL comes from an unset var simply drops out of the bar) ---

# GitHub org or user page the "GH" button opens.
GITHUB_URL=https://github.com/your-org
# Supabase project dashboard the "SB" button opens.
SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/your_project_ref
# Vercel team/project the "VC" button opens.
VERCEL_URL=https://vercel.com/your-team
# Local dev server the "DEV" button focuses.
DEV_URL=http://localhost:3000/
# Obsidian vault NAME (not path) for the "OB" daily-note deep link.
OBSIDIAN_VAULT=your-vault-name
# Project directory the "TM" (Terminal) and "ED" (VS Code) buttons open.
PROJECT_DIR=/absolute/path/to/your/project

# Vercel team and the phone status page, used by status-page/deploy.sh.
# STATUS_PAGE_URL is the page's only access control: it serves real vault
# content to an unauthenticated GET, so the slug must never be committed.
VERCEL_SCOPE=your-team
STATUS_PAGE_URL=https://your-obscured-slug.vercel.app

# Keep the published phone page fresh from inside the server: rebuild and deploy
# every 5 minutes. Off unless set to exactly 1, and left off here on purpose:
# following this template must never silently start uploading vault content. This is the only outbound network
# action the daemon takes, which is why it is opt-in. A launchd timer would be the
# obvious home for it and cannot be, because a headless agent is denied access to
# TCC-protected folders like ~/Desktop; see the comment at the top of publish.js.
VAULT_HUD_PUBLISH=0
