node_modules/
.DS_Store
*.log

# Browser-automation output. Screenshots here render the real vault — never commit.
.playwright-mcp/

# Local, machine-specific config and secrets — never commit.
.env
.env.*
!.env.example

# Real confidential-identifier patterns for the pre-push gate — never commit.
# Only the .example template is tracked.
.confidential-patterns

# Claim-index dumps render real vault content — never commit.
out/
*.claims.json

# Run-status files belong in the vault, never here. A misconfigured agent
# writing a relative 15-Runs/ path would otherwise make them committable.
15-Runs/
status-page/status.html

# Generated by status-page/deploy.sh; the builder is the source.
status-page/public/
status-page/.vercel/
.confidential-identity-exempt

# Design specs are thinking, not code. They live in the vault, which is private;
# this repository is public and a spec carries filesystem paths, gate structure
# and live-exposure detail that a public repo should not.
docs/superpowers/
